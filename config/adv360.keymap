#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>
#include "keymap_uk.h"
/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO
      macro_ver: macro_ver {
        compatible = "zmk,behavior-macro";
        label = "macro_version";
        #binding-cells = <0>;
        bindings = <&kp RET>;
      };
      #endif

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer_normal {
      bindings = <
        &kp ESC      &none         &none      &none      &none       &none      &tog 4                                                                                                              &mo 6      &to 1      &none      &none         &none        &kp UK_MINS      &kp DEL
        &kp TAB      &kp Q         &kp W      &kp E      &kp R       &kp T      &kp LGUI                                                                                                           &kp RGUI  &kp UK_Z   &kp U      &kp I         &kp O        &kp P          &kp UK_LBRC
        &mo 2        &kp A         &kp S      &kp D      &kp F       &kp G      &kp LCTRL                    &kp TAB      &kp LALT                  &kp LGUI       &kp TAB                       &kp RCTRL   &kp H      &kp J      &kp K         &kp L        &kp UK_SCLN    &mo 2
        &kp LSHFT    &kp UK_Y      &kp X      &kp C      &kp V       &kp B                                               &kp HOME                  &kp PG_UP                                               &kp N      &kp M      &kp UK_COMM   &kp UK_DOT   &kp UK_QUOT    &kp RSHFT
        &kp LCTRL    &kp LGUI      &kp LALT   &none      &mo 4                                &kp BSPC      &kp ESC        &kp DEL                   &kp PG_DN      &kp ENTER      &kp SPACE                              &mo 4      &none         &none        &none          &kp RCTRL
      >;
    };
    default_layer_mac {
      bindings = <
        &kp ESC      &none         &none      &none      &none       &none      &tog 5                                                                                                              &mo 6      &to 0      &none      &none         &none        &kp UK_MINS      &kp DEL
        &kp TAB      &kp Q         &kp W      &kp E      &kp R       &kp T      &kp LGUI                                                                                                           &kp RGUI  &kp UK_Z   &kp U      &kp I         &kp O        &kp P          &kp UK_LBRC
        &mo 3        &kp A         &kp S      &kp D      &kp F       &kp G      &kp LCTRL                   &kp TAB      &kp LALT                  &kp LGUI       &kp TAB                       &kp RCTRL   &kp H      &kp J      &kp K         &kp L        &kp UK_SCLN    &mo 3
        &kp LSHFT    &kp UK_Y      &kp X      &kp C      &kp V       &kp B                                               &kp HOME                  &kp PG_UP                                               &kp N      &kp M      &kp UK_COMM   &kp UK_DOT   &kp UK_QUOT    &kp RSHFT
        &kp LCTRL    &kp LGUI      &kp LALT   &none      &mo 5                                &kp BSPC      &kp ESC        &kp DEL                   &kp PG_DN      &kp ENTER      &kp SPACE                              &mo 5      &none         &none        &none          &kp RCTRL
      >;
    };
    neoL3Normal {
      bindings = <
        &kp ESC      &kp N1          &kp N2         &kp N3         &kp N4           &kp N5           &trans                                                                                                           &trans      &kp UK_EURO      &none            &none             &none         &none          &none
        &kp TAB      &none           &kp UK_UNDS    &kp UK_LBRC    &kp UK_RBRC      &kp UK_CIRC      &trans                                                                                                           &trans      &kp UK_EXLM      &kp UK_LABK      &kp UK_RABK       &kp UK_EQL    &kp UK_AMPR    &none
        &none        &kp UK_BSLS     &kp UK_SLSH    &kp UK_LCBR    &kp UK_RCBR      &kp UK_ASTR      &trans                          &kp LCTRL &kp LALT                     &kp LGUI      &kp RCTRL                   &trans      &kp UK_QUES      &kp UK_LPRN      &kp UK_RPRN      &kp UK_MINS   &kp UK_COLN    &kp UK_AT
        &kp LSHFT    &kp UK_HASH     &kp UK_DLR     &kp UK_PIPE    &kp UK_TILD      &kp UK_GRV                                                 &kp HOME                     &kp PG_UP                                             &kp UK_PLUS      &kp UK_PERC      &kp UK_DQUO       &kp UK_QUOT   &kp UK_SCLN    &kp RSHIFT
        &kp LCTRL    &kp LGUI        &kp LALT       &none          &mo 4                                              &kp BSPC      &kp ENTER  &kp END                      &kp PG_DN     &kp ENTER      &kp KP_N0                                 &mo 4            &none             &none         &none          &kp RCTRL
      >;
    };                            
    neoL3Mac {
      bindings = <
        &kp ESC      &kp N1          &kp N2         &kp N3         &kp N4           &kp N5           &trans                                                                                                           &trans      &kp UK_EURO      &none            &none             &none         &none          &none
        &kp TAB      &none           &kp UK_UNDS    &kp UK_LBRC    &kp UK_RBRC      &kp UK_CIRC      &trans                                                                                                           &trans      &kp UK_EXLM      &kp UK_LABK      &kp UK_RABK       &kp UK_EQL    &kp UK_AMPR    &none
        &none        &kp UK_BSLS     &kp UK_SLSH    &kp UK_LCBR    &kp UK_RCBR      &kp UK_ASTR      &trans                          &kp LCTRL &kp LALT                     &kp LGUI      &kp RCTRL                   &trans      &kp UK_QUES      &kp UK_LPRN      &kp UK_RPRN       &kp UK_MINS   &kp UK_COLN    &kp MAC_UK_AT
        &kp LSHFT    &kp UK_HASH     &kp UK_DLR     &kp UK_PIPE    &kp UK_TILD      &kp UK_GRV                                                 &kp HOME                     &kp PG_UP                                             &kp UK_PLUS      &kp UK_PERC      &kp MAC_UK_DQUO   &kp UK_QUOT   &kp UK_SCLN    &kp RSHIFT
        &kp LCTRL    &kp LGUI        &kp LALT       &none          &mo 5                                              &kp BSPC      &kp ENTER  &kp END                      &kp PG_DN     &kp ENTER      &kp KP_N0                                 &mo 5            &none             &none         &none          &kp RCTRL
      >;
    };
    neoL4Normal {
      bindings = <
        &kp F1       &kp F2       &kp F3       &kp F4      &kp F5       &kp F6       &tog 1                                                                         &mo 6        &kp F7        &kp F8        &kp F9        &kp F10        &kp F11        &kp F12
        &trans       &trans       &trans       &kp UP      &trans       &trans       &none                                                                          &none        &trans        &kp KP_N7     &kp KP_N8     &kp KP_N9      &trans         &trans
        &trans       &kp HOME     &kp LEFT     &kp DOWN    &kp RIGHT    &kp END         &none                &trans &trans                  &trans &trans           &none        &trans        &kp KP_N4     &kp KP_N5     &kp KP_N6      &trans         &trans
        &trans       &trans       &trans       &trans      &trans       &trans                                      &trans                  &trans                               &kp KP_N0     &kp KP_N1     &kp KP_N2     &kp KP_N3      &trans         &trans
        &trans       &trans       &trans       &trans      &trans                                  &trans &trans &trans                  &trans &trans &trans                                  &trans        &trans        &trans         &trans         &trans       
      >;      
    };
    neoL4Mac {
      bindings = <
        &kp F1       &kp F2       &kp F3       &kp F4      &kp F5       &kp F6       &tog 1                                                                         &mo 6        &kp F7        &kp F8        &kp F9        &kp F10        &kp F11        &kp F12
        &trans       &trans       &trans       &kp UP      &trans       &trans       &none                                                                          &none        &trans        &kp KP_N7     &kp KP_N8     &kp KP_N9      &trans         &trans
        &trans       &kp LC(A)    &kp LEFT     &kp DOWN    &kp RIGHT    &kp LC(E)       &none                &trans &trans                  &trans &trans           &none        &trans        &kp KP_N4     &kp KP_N5     &kp KP_N6      &trans         &trans
        &trans       &trans       &trans       &trans      &trans       &trans                                      &trans                  &trans                               &kp KP_N0     &kp KP_N1     &kp KP_N2     &kp KP_N3      &trans         &trans
        &trans       &trans       &trans       &trans      &trans                                  &trans &trans &trans                  &trans &trans &trans                                  &trans        &trans        &trans         &trans         &trans       
      >;      
    };
    mod {
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &rgb_ug RGB_MEFS_CMD 5 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };

    gaming {
      bindings = <
        &kp ESC      &kp N1        &kp N2     &kp N3     &kp N4      &kp N5    &tog 4                                                                                                              &mo 3      &none      &none      &none         &none        &kp UK_MINS      &kp DEL
        &kp TAB      &kp Q         &kp W      &kp E      &kp R       &kp T      &kp LCTRL                                                                                                           &kp RCTRL  &kp UK_Z   &kp U      &kp I         &kp O        &kp P          &kp UK_LBRC
        &mo 1        &kp A         &kp S      &kp D      &kp F       &kp G      &kp LGUI                    &kp TAB      &kp LALT                  &kp LGUI       &kp TAB                       &kp RGUI   &kp H      &kp J      &kp K         &kp L        &kp UK_SCLN    &mo 1
        &kp LSHFT    &kp UK_Y      &kp X      &kp C      &kp V       &kp B                                               &kp HOME                  &kp PG_UP                                               &kp N      &kp M      &kp UK_COMM   &kp UK_DOT   &kp UK_QUOT    &kp RSHFT
        &kp LCTRL    &kp LGUI      &kp LALT   &none      &mo 2                                &kp SPACE      &kp ENTER        &kp DEL                   &kp PG_DN      &kp ENTER      &kp SPACE                              &mo 2      &none         &none        &none          &kp RCTRL
      >;
    }; 

  };
};
